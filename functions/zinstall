# Part of zconfig · https://github.com/barabasz/zconfig · MIT License
#
# Install applications using zconfig recipes
# Use 'zinstall --help' for more information.

local -A _fn=(
    [info]="Install applications using zconfig recipes"
    [desc]="Reads a zconfig recipe and installs or configures the requested
            application.

            Use --test for a dry run, --recipe to display the parsed recipe,
            or --verify to validate recipe syntax and schema."
    [version]="0.4.3"
    [created]="2026-10-03"
    [modified]="2026-10-03"
    [license]="MIT"
    [author]="Andrzej Barabasz"
    [required]="dasel"
)

local -a _fn_args=(
    "recipe|Recipe to install or inspect|r"
)

local -a _fn_opts=(
    "test|t|Test recipe without making any changes"
    "recipe|r|Display the parsed recipe and exit"
    "verify|V|Verify recipe syntax and schema"
)

local -a _fn_commands=()

local -a _fn_examples=(
    "zinstall mc|Install and configure Midnight Commander"
    "zinstall -t yazi|Test Yazi recipe without making changes"
    "zinstall -r mc|Display the parsed Midnight Commander recipe"
    "zinstall -V mc|Verify Midnight Commander recipe"
)

local -A opts=() args=()
_fn_init "$@" || return $REPLY

local recipe_id="${args[recipe]}"
local test_mode=$(( ${+opts[test]} ))
local recipe_mode=$(( ${+opts[recipe]} ))
local verify_mode=$(( ${+opts[verify]} ))

if (( test_mode + recipe_mode + verify_mode > 1 )); then
    printe "Options ${c}--test${x}, ${c}--recipe${x}, and ${c}--verify${x} are mutually exclusive."
    return 2
fi

local confdir="${CONFDIR:-${XDG_CONFIG_HOME:-$HOME/.config}}"
local zdotdir="${ZDOTDIR:-$confdir/zsh}"
local recipes_dir="${ZSH_RECIPES_DIR:-$zdotdir/recipes}"
local recipe_file="$recipes_dir/$recipe_id.kdl"

# --- Internal helpers --------------------------------------------------------

_zinstall_heading() {
    (( ARGC == 1 )) || return 2
    print
    printc "$1" "$y"
}

_zinstall_kv() {
    (( ARGC == 2 )) || return 2
    local key="$1" value="$2" line

    # printkv handles single-line values. For multiline values, print the key
    # once and indent every content line so section formatting stays readable.
    if [[ "$value" == *$'\n'* ]]; then
        print -r -- "  ${key}:"
        for line in "${(@f)value}"; do
            print -r -- "    $line"
        done
    else
        printkv "  $key" "$value"
    fi
}

_zinstall_line() {
    (( ARGC == 1 )) || return 2
    print -- "  $1"
}

# Read one KDL scalar and remove one level of JSON quoting.
_zinstall_get() {
    (( ARGC == 2 )) || return 2
    local raw
    raw=$(dasel -i kdl -o json "$2" < "$1" 2>/dev/null) || return 1
    REPLY=$(str_unquote "$raw")
}

# Count a KDL node that dasel exposes either as one object or an array.
_zinstall_count() {
    (( ARGC == 2 )) || return 2
    local json i=0
    json=$(dasel -i kdl -o json "$2" < "$1" 2>/dev/null) || {
        REPLY=0
        return 0
    }

    if [[ "$json" == \{* ]]; then
        REPLY=1
    elif [[ "$json" == \[* ]]; then
        while dasel -i kdl -o json "${2}[$i]" < "$1" >/dev/null 2>&1; do
            (( i++ ))
        done
        REPLY=$i
    else
        return 1
    fi
}

# Return selector for item INDEX (1-based) from a single node / repeated nodes.
_zinstall_item_selector() {
    (( ARGC == 3 )) || return 2
    local base="$1" count="$2" index="$3"
    if (( count == 1 )); then
        REPLY="$base"
    else
        REPLY="${base}[$(( index - 1 ))]"
    fi
}

# Expand only variables explicitly supported in recipe paths. No eval.
_zinstall_expand_path() {
    (( ARGC == 1 )) || return 2
    local value="$1"
    local xdg_config="${XDG_CONFIG_HOME:-$confdir}"
    local xdg_data="${XDG_DATA_HOME:-$HOME/.local/share}"
    local xdg_cache="${XDG_CACHE_HOME:-$HOME/.cache}"
    local xdg_state="${XDG_STATE_HOME:-$HOME/.local/state}"
    local ghconf="${GHCONFDIR:-}"

    value="${value//\$\{XDG_CONFIG_HOME\}/$xdg_config}"
    value="${value//\$XDG_CONFIG_HOME/$xdg_config}"
    value="${value//\$\{XDG_DATA_HOME\}/$xdg_data}"
    value="${value//\$XDG_DATA_HOME/$xdg_data}"
    value="${value//\$\{XDG_CACHE_HOME\}/$xdg_cache}"
    value="${value//\$XDG_CACHE_HOME/$xdg_cache}"
    value="${value//\$\{XDG_STATE_HOME\}/$xdg_state}"
    value="${value//\$XDG_STATE_HOME/$xdg_state}"
    value="${value//\$\{CONFDIR\}/$confdir}"
    value="${value//\$CONFDIR/$confdir}"
    value="${value//\$\{GHCONFDIR\}/$ghconf}"
    value="${value//\$GHCONFDIR/$ghconf}"
    value="${value//\$\{HOME\}/$HOME}"
    value="${value//\$HOME/$HOME}"

    REPLY="$value"
}

# real_path = actual files; link_path = symlink path.
# reply[1] = state, reply[2] = action, reply[3] = current destination if link exists.
_zinstall_link_status() {
    (( ARGC == 2 )) || return 2
    local real_path="$1" link_path="$2" current=""
    reply=()

    if [[ ! -e "$real_path" && ! -L "$real_path" ]]; then
        reply=("files missing" "none" "")
    elif is_link "$link_path"; then
        current=$(resolve_link "$link_path" 2>/dev/null)
        if [[ "${link_path:A}" == "${real_path:A}" ]]; then
            reply=("correctly linked" "none" "$current")
        else
            reply=("symlink points elsewhere" "replace symlink" "$current")
        fi
    elif is_file "$link_path"; then
        reply=("regular file exists at link path" "backup to .bak and create symlink" "")
    elif is_dir "$link_path"; then
        reply=("directory exists at link path" "backup to .bak and create symlink" "")
    elif [[ -e "$link_path" ]]; then
        reply=("object exists at link path" "backup to .bak and create symlink" "")
    else
        reply=("link missing" "create symlink" "")
    fi
}

# --- Parse and validate ------------------------------------------------------

if ! is_file "$recipe_file"; then
    printe "Recipe not found: ${c}${recipe_file}${x}"
    return 1
fi

if ! dasel -i kdl -o json < "$recipe_file" >/dev/null 2>&1; then
    printe "Invalid KDL syntax: ${c}${recipe_file}${x}"
    return 1
fi

local root_type root_id schema
if _zinstall_get "$recipe_file" 'recipe.id'; then
    root_type="recipe"
    root_id="$REPLY"
elif _zinstall_get "$recipe_file" 'bundle.id'; then
    root_type="bundle"
    root_id="$REPLY"
else
    printe "Unsupported recipe root in: ${c}${recipe_file}${x}"
    return 1
fi

if [[ "$root_id" != "$recipe_id" ]]; then
    printe "Recipe ID '${c}${root_id}${x}' does not match filename '${c}${recipe_id}.kdl${x}'."
    return 1
fi

if ! _zinstall_get "$recipe_file" "${root_type}.schema"; then
    printe "Missing required property: ${c}${root_type}.schema${x}"
    return 1
fi
schema="$REPLY"

if [[ "$schema" != "1" ]]; then
    printe "Unsupported ${root_type} schema: ${c}${schema}${x}"
    return 1
fi

if [[ "$root_type" == "bundle" ]]; then
    if (( verify_mode )); then
        prints "Bundle ${c}${recipe_id}${x} is valid (schema ${schema})."
        return 0
    fi
    printw "Bundle '${c}${recipe_id}${x}' detected; bundle expansion is not implemented yet."
    return 0
fi

local name command="" description="" homepage=""
local package method="brew" install_type=""
local config_dir="$recipe_id"

_zinstall_get "$recipe_file" 'recipe.name' || {
    printe "Missing required field: ${c}recipe.name${x}"
    return 1
}
name="$REPLY"

_zinstall_get "$recipe_file" 'recipe.command' && command="$REPLY"
_zinstall_get "$recipe_file" 'recipe.description' && description="$REPLY"
_zinstall_get "$recipe_file" 'recipe.homepage' && homepage="$REPLY"

_zinstall_get "$recipe_file" 'recipe.install.package' || {
    printe "Missing required property: ${c}recipe.install.package${x}"
    return 1
}
package="$REPLY"

_zinstall_get "$recipe_file" 'recipe.install.method' && method="$REPLY"
_zinstall_get "$recipe_file" 'recipe.install.type' && install_type="$REPLY"
_zinstall_get "$recipe_file" 'recipe.config.dir' && config_dir="$REPLY"

case "$method" in
    brew|apt) ;;
    *)
        printe "Unsupported installation method in schema 1: ${c}${method}${x}"
        return 1
        ;;
esac

if [[ -n "$install_type" && "$method" != "brew" ]]; then
    printe "Install type '${c}${install_type}${x}' is only supported with Homebrew."
    return 1
fi
if [[ -n "$install_type" && "$install_type" != "cask" ]]; then
    printe "Unsupported Homebrew install type: ${c}${install_type}${x}"
    return 1
fi

local link_count extra_count run_count mkdir_count
_zinstall_count "$recipe_file" 'recipe.config.link' || return 1
link_count=$REPLY
_zinstall_count "$recipe_file" 'recipe.extras.install' || return 1
extra_count=$REPLY
_zinstall_count "$recipe_file" 'recipe.setup.run' || return 1
run_count=$REPLY
_zinstall_count "$recipe_file" 'recipe.setup.mkdir' || return 1
mkdir_count=$REPLY

# Validate repeated nodes used by the execution engine.
local i selector when
for (( i=1; i<=link_count; i++ )); do
    _zinstall_item_selector 'recipe.config.link' "$link_count" "$i"
    selector="$REPLY"
    _zinstall_get "$recipe_file" "${selector}.source" || {
        printe "Missing required property: ${c}${selector}.source${x}"
        return 1
    }
done

for (( i=1; i<=extra_count; i++ )); do
    _zinstall_item_selector 'recipe.extras.install' "$extra_count" "$i"
    selector="$REPLY"
    _zinstall_get "$recipe_file" "${selector}.id" || {
        printe "Missing required property: ${c}${selector}.id${x}"
        return 1
    }
done

for (( i=1; i<=run_count; i++ )); do
    _zinstall_item_selector 'recipe.setup.run' "$run_count" "$i"
    selector="$REPLY"
    _zinstall_get "$recipe_file" "${selector}.command" || {
        printe "Missing required property: ${c}${selector}.command${x}"
        return 1
    }
    if _zinstall_get "$recipe_file" "${selector}.when"; then
        when="$REPLY"
        [[ "$when" == "always" || "$when" == "new" ]] || {
            printe "Unsupported setup condition: ${c}${when}${x}"
            return 1
        }
    fi
done

for (( i=1; i<=mkdir_count; i++ )); do
    _zinstall_item_selector 'recipe.setup.mkdir' "$mkdir_count" "$i"
    selector="$REPLY"
    _zinstall_get "$recipe_file" "${selector}.path" || {
        printe "Missing required property: ${c}${selector}.path${x}"
        return 1
    }
done

if (( verify_mode )); then
    prints "Recipe ${c}${recipe_id}${x} is valid (KDL syntax and schema ${schema})."
    return 0
fi

# --- Parsed recipe view ------------------------------------------------------

_zinstall_show_recipe() {
    local j sel source_spec target_spec real_path link_path extra label cmd mkdir_path item_when

    _zinstall_heading "Recipe"
    _zinstall_kv "File" "$recipe_file"
    _zinstall_kv "ID" "$recipe_id"
    _zinstall_kv "Schema" "$schema"
    _zinstall_kv "Name" "$name"
    [[ -n "$description" ]] && _zinstall_kv "Description" "$description"
    [[ -n "$homepage" ]] && _zinstall_kv "Homepage" "$homepage"
    [[ -n "$command" ]] && _zinstall_kv "Command" "$command"

    _zinstall_heading "Install"
    _zinstall_kv "Method" "$method"
    _zinstall_kv "Package" "$package"
    [[ -n "$install_type" ]] && _zinstall_kv "Type" "$install_type"

    _zinstall_heading "Config"
    _zinstall_kv "Directory" "$config_dir"
    real_path="\$GHCONFDIR/$config_dir"
    link_path="\$CONFDIR/$config_dir"
    _zinstall_kv "Files" "$real_path"
    _zinstall_kv "Link" "$link_path -> $real_path"

    if (( link_count )); then
        _zinstall_heading "Additional config links"
        for (( j=1; j<=link_count; j++ )); do
            _zinstall_item_selector 'recipe.config.link' "$link_count" "$j"
            sel="$REPLY"
            _zinstall_get "$recipe_file" "${sel}.source"
            source_spec="$REPLY"
            if _zinstall_get "$recipe_file" "${sel}.target"; then
                target_spec="$REPLY"
            else
                target_spec="\$CONFDIR/$source_spec"
            fi
            real_path="\$GHCONFDIR/$source_spec"
            link_path="$target_spec"
            _zinstall_kv "Files" "$real_path"
            _zinstall_kv "Link $j" "$link_path -> $real_path"
        done
    fi

    if (( extra_count )); then
        _zinstall_heading "Extras"
        for (( j=1; j<=extra_count; j++ )); do
            _zinstall_item_selector 'recipe.extras.install' "$extra_count" "$j"
            sel="$REPLY"
            _zinstall_get "$recipe_file" "${sel}.id"
            _zinstall_kv "Install $j" "$REPLY"
        done
    fi

    if (( mkdir_count || run_count )); then
        _zinstall_heading "Setup"
        for (( j=1; j<=mkdir_count; j++ )); do
            _zinstall_item_selector 'recipe.setup.mkdir' "$mkdir_count" "$j"
            sel="$REPLY"
            _zinstall_get "$recipe_file" "${sel}.path"
            mkdir_path="$REPLY"
            _zinstall_kv "mkdir $j" "$mkdir_path"
        done
        for (( j=1; j<=run_count; j++ )); do
            _zinstall_item_selector 'recipe.setup.run' "$run_count" "$j"
            sel="$REPLY"
            label=""
            item_when="always"
            _zinstall_get "$recipe_file" "${sel}.label" && label="$REPLY"
            _zinstall_get "$recipe_file" "${sel}.when" && item_when="$REPLY"
            _zinstall_get "$recipe_file" "${sel}.command"
            cmd="$REPLY"
            _zinstall_kv "Run $j" "${label:-$cmd}"
            [[ -n "$label" ]] && _zinstall_kv "Command" "$cmd"
            [[ "$item_when" != "always" ]] && _zinstall_kv "When" "$item_when"
        done
    fi
}

if (( recipe_mode )); then
    _zinstall_show_recipe
    return 0
fi

# --- Execute / dry-run -------------------------------------------------------

local ghconf_state config_real_path="" config_link_path="$confdir/$config_dir"
if [[ -z ${GHCONFDIR:-} ]]; then
    ghconf_state="GHCONFDIR is not set"
elif ! is_dir "$GHCONFDIR"; then
    ghconf_state="GHCONFDIR directory does not exist"
else
    ghconf_state="available"
    config_real_path="$GHCONFDIR/$config_dir"
fi

local application_installed=0 installed_now=0
[[ -n "$command" ]] && is_installed "$command" && application_installed=1

_zinstall_heading "Recipe"
_zinstall_kv "ID" "$recipe_id"
_zinstall_kv "Name" "$name"
_zinstall_kv "Schema" "$schema"

_zinstall_heading "Application"
[[ -n "$command" ]] && _zinstall_kv "Command" "$command"

if (( application_installed )); then
    _zinstall_kv "State" "installed"
    local app_info
    app_info=$(zinfo -s "$command" 2>/dev/null)
    [[ -n "$app_info" ]] && _zinstall_line "$app_info"
    _zinstall_kv "Action" "none"
else
    _zinstall_kv "State" "not installed"
    if (( test_mode )); then
        installed_now=1
        if [[ "$method" == "brew" && "$install_type" == "cask" ]]; then
            _zinstall_kv "Action" "would install with brew cask: $package"
        else
            _zinstall_kv "Action" "would install with $method: $package"
        fi
    else
        _zinstall_kv "Action" "install with $method: $package"
        local -a appinstall_args=()
        [[ "$method" == "brew" ]] && appinstall_args+=(--brew)
        [[ "$method" == "apt" ]] && appinstall_args+=(--apt)
        [[ "$install_type" == "cask" ]] && appinstall_args+=(--cask)

        appinstall --quiet --yes "${appinstall_args[@]}" "$package" || return $?
        installed_now=1

        if [[ -n "$command" ]] && ! is_installed "$command"; then
            printe "Installation completed, but command '${c}${command}${x}' is not available."
            return 1
        fi
    fi
fi

# Extras are deliberately simple: recipe wins, otherwise appinstall.
if (( extra_count )); then
    local extra stack
    _zinstall_heading "Extras"
    for (( i=1; i<=extra_count; i++ )); do
        _zinstall_item_selector 'recipe.extras.install' "$extra_count" "$i"
        selector="$REPLY"
        _zinstall_get "$recipe_file" "${selector}.id"
        extra="$REPLY"
        _zinstall_kv "Extra $i" "$extra"

        if is_file "$recipes_dir/$extra.kdl"; then
            stack="${ZINSTALL_STACK:-}"
            if [[ ":$stack:" == *":$extra:"* || "$extra" == "$recipe_id" ]]; then
                printe "Circular extra recipe dependency detected: ${c}${extra}${x}"
                return 1
            fi
            local ZINSTALL_STACK="${stack:+$stack:}$recipe_id"
            if (( test_mode )); then
                zinstall -t "$extra" || return $?
            else
                zinstall "$extra" || return $?
            fi
        else
            if (( test_mode )); then
                appinstall --dry-run "$extra" || return $?
            else
                appinstall --quiet --yes "$extra" || return $?
            fi
        fi
    done
fi

# Standard config is implicit. Actual files live in GHCONFDIR; CONFDIR holds the symlink.
# Relationship: CONFDIR/<dir> -> GHCONFDIR/<dir>.
_zinstall_heading "Config"
_zinstall_kv "Directory" "$config_dir"
_zinstall_kv "GHCONFDIR" "$ghconf_state"

if [[ "$ghconf_state" == "available" ]]; then
    _zinstall_kv "Files" "$config_real_path"
    _zinstall_kv "Link" "$config_link_path -> $config_real_path"

    if [[ -e "$config_real_path" || -L "$config_real_path" ]]; then
        _zinstall_kv "User config" "found"
        _zinstall_link_status "$config_real_path" "$config_link_path"
        _zinstall_kv "Link state" "${reply[1]}"
        [[ -n "${reply[3]}" ]] && _zinstall_kv "Current link" "$config_link_path -> ${reply[3]}"
        if [[ "${reply[2]}" == "none" ]]; then
            _zinstall_kv "Action" "none"
        elif (( test_mode )); then
            _zinstall_kv "Action" "would ${reply[2]}"
        else
            _zinstall_kv "Action" "${reply[2]}"
            lns "$config_real_path" "$config_link_path" || return $?
            prints "Configuration linked: ${c}${config_link_path}${x} -> ${c}${config_real_path}${x}"
        fi
    else
        _zinstall_kv "User config" "not found"
        _zinstall_kv "Action" "use application default configuration"
    fi
else
    _zinstall_kv "Action" "skip user configuration and use application defaults"
fi

# Explicit additional links. KDL uses source/target; internally we resolve them
# to real_path (actual files) and link_path (symlink path).
if (( link_count )); then
    local source_spec target_spec real_path link_path
    _zinstall_heading "Additional config links"
    for (( i=1; i<=link_count; i++ )); do
        _zinstall_item_selector 'recipe.config.link' "$link_count" "$i"
        selector="$REPLY"
        _zinstall_get "$recipe_file" "${selector}.source"
        source_spec="$REPLY"
        if _zinstall_get "$recipe_file" "${selector}.target"; then
            target_spec="$REPLY"
        else
            target_spec="$confdir/$source_spec"
        fi

        if [[ "$ghconf_state" != "available" ]]; then
            printw "Skipping '${c}${source_spec}${x}': GHCONFDIR is not available."
            continue
        fi

        real_path="$GHCONFDIR/$source_spec"
        _zinstall_expand_path "$target_spec"
        link_path="$REPLY"
        _zinstall_kv "Files" "$real_path"
        _zinstall_kv "Link" "$link_path -> $real_path"

        if [[ ! -e "$real_path" && ! -L "$real_path" ]]; then
            printw "Additional config files not found: ${c}${real_path}${x}"
            continue
        fi

        _zinstall_link_status "$real_path" "$link_path"
        _zinstall_kv "Link state" "${reply[1]}"
        [[ -n "${reply[3]}" ]] && _zinstall_kv "Current link" "$link_path -> ${reply[3]}"
        if [[ "${reply[2]}" == "none" ]]; then
            _zinstall_kv "Action" "none"
        elif (( test_mode )); then
            _zinstall_kv "Action" "would ${reply[2]}"
        else
            _zinstall_kv "Action" "${reply[2]}"
            lns "$real_path" "$link_path" || return $?
            prints "Additional configuration linked: ${c}${link_path}${x} -> ${c}${real_path}${x}"
        fi
    done
fi

# Setup. Current test recipes use run actions. mkdir is supported as a small
# declarative convenience and is processed before run actions.
if (( mkdir_count || run_count )); then
    local mkdir_path label cmd item_when
    _zinstall_heading "Setup"

    for (( i=1; i<=mkdir_count; i++ )); do
        _zinstall_item_selector 'recipe.setup.mkdir' "$mkdir_count" "$i"
        selector="$REPLY"
        _zinstall_get "$recipe_file" "${selector}.path"
        mkdir_path="$REPLY"
        _zinstall_expand_path "$mkdir_path"
        mkdir_path="$REPLY"
        item_when="always"
        _zinstall_get "$recipe_file" "${selector}.when" && item_when="$REPLY"

        if [[ "$item_when" == "new" && $installed_now -eq 0 ]]; then
            _zinstall_kv "Skip" "mkdir $mkdir_path (when=new)"
        elif (( test_mode )); then
            if [[ "$item_when" == "always" ]]; then
                _zinstall_kv "mkdir $i" "would create $mkdir_path"
            else
                _zinstall_kv "mkdir $i" "would create $mkdir_path (when=$item_when)"
            fi
        else
            _zinstall_kv "mkdir $i" "$mkdir_path"
            mkdir -p "$mkdir_path" || {
                printe "Cannot create directory: ${c}${mkdir_path}${x}"
                return 1
            }
        fi
    done

    for (( i=1; i<=run_count; i++ )); do
        _zinstall_item_selector 'recipe.setup.run' "$run_count" "$i"
        selector="$REPLY"
        label=""
        item_when="always"
        _zinstall_get "$recipe_file" "${selector}.label" && label="$REPLY"
        _zinstall_get "$recipe_file" "${selector}.when" && item_when="$REPLY"
        _zinstall_get "$recipe_file" "${selector}.command"
        cmd="$REPLY"

        if [[ "$item_when" == "new" && $installed_now -eq 0 ]]; then
            _zinstall_kv "Skip" "${label:-$cmd} (when=new)"
            continue
        fi

        if (( test_mode )); then
            _zinstall_kv "Run $i" "would run: ${label:-$cmd}"
            [[ -n "$label" ]] && _zinstall_kv "Command" "$cmd"
            [[ "$item_when" != "always" ]] && _zinstall_kv "When" "$item_when"
        else
            _zinstall_kv "Run $i" "${label:-$cmd}"
            eval "$cmd" || {
                printe "Setup action failed: ${c}${label:-$cmd}${x}"
                return 1
            }
        fi
    done
fi

_zinstall_heading "Result"
if (( test_mode )); then
    printi "Test complete: no changes were made."
elif [[ -n "$command" ]]; then
    if is_installed "$command"; then
        local final_info
        final_info=$(zinfo -s "$command" 2>/dev/null)
        [[ -n "$final_info" ]] && _zinstall_line "$final_info"
        prints "${g}${name}${x} is installed and recipe processing completed."
    else
        printe "Recipe processing completed, but command '${c}${command}${x}' is not available."
        return 1
    fi
else
    prints "Recipe processing completed."
fi

return 0
