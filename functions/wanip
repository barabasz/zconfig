#
# Retrieve the public IP address (IPv4 or IPv6)
# Use 'wanip --help' for more information.

local -A _fn=(
    [info]="Retrieve the public IP address (IPv4 or IPv6)"
    [desc]="Queries many DNS and HTTP services in parallel and prints the first valid answer.
            The remaining queries are cancelled, so a slow or dead service does not delay the result."
    [version]="0.7.0"
    [created]="2024-02-26"
    [modified]="2026-11-15"
    [license]="MIT"
    [author]="Andrzej Barabasz"
    [notes]="Requires dig, curl or wget. DNS services use dig, HTTP services use curl, or wget without curl.
             The timeout bounds the whole query, not each service. The service list is in get_public_ip (lib/network.zsh)."
)

local -a _fn_args=()
local -a _fn_opts=(
    "ipv6|6|Get IPv6 address instead of IPv4"
    "verbose|V|Show which service answered first and how fast"
    "timeout|t|Timeout in seconds (default: 2)|sec|integer[1;30]"
)
local -a _fn_commands=()
local -a _fn_examples=(
    "wanip|Get IPv4 address"
    "wanip -6|Get IPv6 address"
    "wanip -V|Show the fastest service"
    "wanip -t 5|Wait up to 5 seconds"
)

local -A opts=() args=()
_fn_init "$@" || return $REPLY

local -a ip_opts=(-t ${opts[timeout]:-2})
(( ${+opts[ipv6]} )) && ip_opts+=(-6)

local -F start=$EPOCHREALTIME
get_public_ip $ip_opts >/dev/null
case $status in
    0)
        if (( ${+opts[verbose]} )); then
            local ms
            printf -v ms "%.0f" $(( (EPOCHREALTIME - start) * 1000 ))
            printi "IP found using $reply[2] in $ms ms"
        fi
        print -r -- $REPLY
        ;;
    127)
        printe "Missing dependencies: 'dig', 'curl' or 'wget' required."
        return 1
        ;;
    *)
        printe "Failed to retrieve public IP address"
        return 1
        ;;
esac
