/- kdl-version 2

recipe id="gh" schema=1 {
    name "GitHub CLI"
    description "GitHub command-line interface"
    homepage "https://cli.github.com/"
    command "gh"

    install package="gh"

    config auto=false

    setup {
        run label="Check GitHub authentication" command=#"""
            if gh auth status >/dev/null 2>&1; then
                gh auth status
            else
                gh auth login
            fi
            """#
    }
}
