#!/usr/bin/env zsh
# Part of zconfig · https://github.com/barabasz/zconfig · MIT License
#
# Generate docs/FUNCTIONS.md from `zman -m` (lib/ and functions/)
# Usage: zsh scripts/functions-md.zsh [--check]
#   --check: do not write; exit 1 if docs/FUNCTIONS.md is out of date

local repo=${${(%):-%x}:A:h:h}
local target=$repo/docs/FUNCTIONS.md

local test_locale=C.UTF-8
[[ $OSTYPE == darwin* ]] && test_locale=en_US.UTF-8

local table
table=$(LANG=$test_locale LC_ALL=$test_locale zsh -f -c "
    source ${(q)repo}/tests/run.zsh --lib-only
    fpath=(${(q)repo}/functions \$fpath)
    autoload -Uz zman
    zman -m
") || { print -u2 "zman -m failed"; exit 1 }

local content="# zconfig: List of Functions

Part of [zconfig](../README.md) documentation.
List of available functions and helper functions with descriptions.
Generated by \`zsh scripts/functions-md.zsh\` (from \`zman -m\`); do not edit by hand.

$table"

if [[ ${1:-} == --check ]]; then
    if [[ "$(<$target)" != "$content" ]]; then
        print -u2 "docs/FUNCTIONS.md is out of date. Run: zsh scripts/functions-md.zsh"
        exit 1
    fi
    print "docs/FUNCTIONS.md is up to date."
    exit 0
fi

print -r -- "$content" > $target
print "Written: docs/FUNCTIONS.md"
